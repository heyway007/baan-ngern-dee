{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baan-ngern-dee",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "ALLOWED_ORIGIN"
    ]
  }
}
