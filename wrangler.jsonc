{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baan-ngern-dee",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/config",
      "/health",
      "/v1/*"
    ]
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "SUPER_ADMIN_USER_ID"
    ]
  }
}
