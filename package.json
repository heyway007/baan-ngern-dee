{
  "name": "systems-credit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "deploy:worker": "wrangler deploy -c wrangler.jsonc",
    "dev:api": "npm run dev -w @systems-credit/api",
    "dev:web": "npm run dev -w @systems-credit/web",
    "test": "vitest",
    "test:line": "node --test tools/line-rich-menu.test.mjs",
    "test:db": "vitest --run workers/api/test/identity-database.test.ts workers/api/test/accounts-database.test.ts workers/api/test/transactions-database.test.ts workers/api/test/transfers-database.test.ts workers/api/test/installments-database.test.ts workers/api/test/finance-snapshot-database.test.ts workers/api/test/recurring-database.test.ts workers/api/test/planning-database.test.ts workers/api/test/user-invitations-database.test.ts workers/api/test/user-management-database.test.ts workers/api/test/slip-imports-database.test.ts workers/api/test/slip-batch-database.test.ts",
    "test:db:supabase": "supabase test db",
    "test:e2e": "playwright test",
    "generate:line-menu": "node tools/generate-line-rich-menu.mjs",
    "provision:line-menu": "node tools/provision-line-rich-menu.mjs",
    "validate:line-menu": "node tools/validate-line-rich-menu.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.54.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
